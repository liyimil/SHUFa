# Runtime
NODE_ENV=development
APP_ENV=local
JWT_SECRET=replace-with-at-least-32-random-characters
PHONE_HASH_PEPPER=replace-with-a-separate-32-character-secret
ADMIN_ACCOUNTS_JSON=[{"email":"admin@example.com","passwordHash":"scrypt$replace-salt$replace-base64url-digest","roles":["ADMIN"]}]

# Core API
API_PORT=3001
API_BASE_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ASSET_BASE_URL=http://localhost:9000/calligraphy-public
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Data services (enabled in the infrastructure milestone)
DATABASE_URL=postgresql://calligraphy:calligraphy@localhost:5432/calligraphy
POSTGRES_DB=calligraphy
POSTGRES_USER=calligraphy
POSTGRES_PASSWORD=calligraphy
REDIS_URL=redis://localhost:6379
INTERNAL_WORKER_TOKEN=replace-with-at-least-32-random-characters
ARTWORK_DELETION_DELAY_SECONDS=0
WEB_CACHE_INVALIDATION_URL=http://localhost:3000/api/internal/catalog-cache
WEB_CACHE_INVALIDATION_TOKEN=replace-with-at-least-32-random-characters
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_ACCESS_KEY=calligraphy
S3_SECRET_KEY=change-me
S3_BUCKET_PRIVATE=calligraphy-private
S3_BUCKET_PUBLIC=calligraphy-public
MINIO_ROOT_USER=calligraphy
MINIO_ROOT_PASSWORD=change-me-now

# AI service
AI_SERVICE_URL=http://localhost:8000
