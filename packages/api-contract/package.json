{
  "name": "@calligraphy/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-typescript openapi.json -o src/generated.ts --alphabetize",
    "check": "openapi-typescript openapi.json -o src/generated.ts --alphabetize --check",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.12.0",
    "typescript": "^5.9.3"
  }
}
