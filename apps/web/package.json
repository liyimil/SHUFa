{
  "name": "@calligraphy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "e2e": "pnpm run build && pnpm run e2e:ci",
    "e2e:ci": "node e2e/prepare-standalone.mjs && playwright test",
    "start": "next start --port 3000",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calligraphy/api-contract": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
