{
  "name": "@calligraphy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "openapi:check": "pnpm --filter @calligraphy/observability build && prisma generate --config prisma.config.ts && tsx scripts/generate-openapi.mts --check",
    "openapi:write": "pnpm --filter @calligraphy/observability build && prisma generate --config prisma.config.ts && tsx scripts/generate-openapi.mts",
    "dev": "tsx watch src/main.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "start": "node dist/main.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "prisma generate --config prisma.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "@calligraphy/observability": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
