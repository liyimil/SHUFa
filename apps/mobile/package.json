{
  "name": "@calligraphy/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "expo export --platform android --output-dir dist",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@calligraphy/api-contract": "workspace:*",
    "expo": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.2",
    "expo-image-manipulator": "~57.0.5",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.7",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
